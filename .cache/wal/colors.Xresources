! X colors.
! Generated by 'wal'
*foreground:        #c0d0e0
*background:        #0a0a11
*.foreground:       #c0d0e0
*.background:       #0a0a11
emacs*foreground:   #c0d0e0
emacs*background:   #0a0a11
URxvt*foreground:   #c0d0e0
XTerm*foreground:   #c0d0e0
UXTerm*foreground:  #c0d0e0
URxvt*background:   [100]#0a0a11
XTerm*background:   #0a0a11
UXTerm*background:  #0a0a11
URxvt*cursorColor:  #c0d0e0
XTerm*cursorColor:  #c0d0e0
UXTerm*cursorColor: #c0d0e0
URxvt*borderColor:  [100]#0a0a11

! Colors 0-15.
*.color0: #0a0a11
*color0:  #0a0a11
*.color1: #444659
*color1:  #444659
*.color2: #525569
*color2:  #525569
*.color3: #60647A
*color3:  #60647A
*.color4: #6D738A
*color4:  #6D738A
*.color5: #7988A1
*color5:  #7988A1
*.color6: #8895AF
*color6:  #8895AF
*.color7: #c0d0e0
*color7:  #c0d0e0
*.color8: #86919c
*color8:  #86919c
*.color9: #444659
*color9:  #444659
*.color10: #525569
*color10:  #525569
*.color11: #60647A
*color11:  #60647A
*.color12: #6D738A
*color12:  #6D738A
*.color13: #7988A1
*color13:  #7988A1
*.color14: #8895AF
*color14:  #8895AF
*.color15: #c0d0e0
*color15:  #c0d0e0

! Black color that will not be affected by bold highlighting.
*.color66: #0a0a11
*color66:  #0a0a11

! Xclock colors.
XClock*foreground: #c0d0e0
XClock*background: #0a0a11
XClock*majorColor:  rgba:c0/d0/e0/ff
XClock*minorColor:  rgba:c0/d0/e0/ff
XClock*hourColor:   rgba:c0/d0/e0/ff
XClock*minuteColor: rgba:c0/d0/e0/ff
XClock*secondColor: rgba:c0/d0/e0/ff

! Set depth to make transparency work.
URxvt*depth: 32
